# Скопіюйте цей файл у .env і заповніть. Файл .env у git не потрапляє.
# На GitHub Actions ці значення задаються як Secrets / Variables репозиторію.

# Який AI використовувати: anthropic | openai | azure
LLM_PROVIDER=anthropic

# Ключ обраного провайдера
LLM_API_KEY=



# Модель. Для anthropic за замовчуванням claude-haiku-4-5.
# Для openai — назва моделі, для azure — назва deployment.
LLM_MODEL=claude-haiku-4-5

# Лише для LLM_PROVIDER=azure
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
